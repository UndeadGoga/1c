{
  "dashboard": {
    "id": null,
    "uid": "1c-cluster-overview",
    "title": "1C Cluster Overview",
    "tags": ["1c", "cluster"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "graph",
        "title": "CPU Usage",
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "Memory Usage",
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "stat",
        "title": "PostgreSQL Status",
        "targets": [
          {
            "expr": "pg_up",
            "legendFormat": "PostgreSQL {{instance}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "HAProxy Backend Servers",
        "targets": [
          {
            "expr": "haproxy_backend_up",
            "legendFormat": "{{backend}}/{{server}}",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
